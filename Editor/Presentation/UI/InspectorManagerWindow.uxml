<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <!-- 標準ヘッダー (トップバー: ⋮ メニューから詳細設定を開閉) -->
    <ui:VisualElement name="appbar" class="dennoko-appbar">
        <ui:VisualElement class="dennoko-appbar__title">
            <ui:Label name="appbar-title" text="Inspector Manager V2" class="dennoko-title" />
        </ui:VisualElement>
        <ui:VisualElement class="dennoko-appbar__actions">
            <ui:Button name="appbar-lang" text="EN" class="dennoko-appbar-lang" />
            <ui:Button name="appbar-settings" class="dennoko-icon-button" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- 障害・復元未完了バナー (Faulted / 復元未完了時のみ表示) -->
    <ui:VisualElement name="fault-banner" class="dennoko-inline-warning imv2-banner-fixed">
        <ui:Label name="fault-banner-text" text="" class="dennoko-inline-warning__text" />
        <ui:Button name="retry-restore-button" text="復元を再試行" class="dennoko-inline-warning__action" />
    </ui:VisualElement>

    <!-- 能力不足・保存停止警告バナー (必要時のみ表示) -->
    <ui:HelpBox name="warning-helpbox" text="" message-type="Warning" class="dennoko-helpbox--warning imv2-helpbox-fixed" />

    <!-- 稼働中セッションバナー (B7: コンパクト固定バー) -->
    <ui:VisualElement name="running-banner" class="dennoko-session-banner imv2-running-banner">
        <ui:VisualElement class="dennoko-session-dot" />
        <ui:Label name="running-banner-state" text="稼働中" class="dennoko-session-banner__state" />
        <ui:Label name="running-banner-detail" text="履歴モード (MRU)" class="dennoko-session-banner__target" />
    </ui:VisualElement>

    <!-- メインスクロール領域 -->
    <ui:ScrollView name="main-scroll" class="dennoko-scroll imv2-scroll">

        <!-- 管理対象 Inspector 一覧カード -->
        <ui:VisualElement name="managed-card" class="dennoko-card imv2-section-card">
            <ui:VisualElement class="dennoko-card-header dennoko-card-header--row">
                <ui:Label name="managed-card-title" text="管理対象 Inspector (0)" class="dennoko-section-title dennoko-card-header__title" />
                <ui:Button name="refresh-button" class="dennoko-icon-button" />
                <ui:Button name="reset-layout-button" class="dennoko-icon-button" />
            </ui:VisualElement>

            <ui:VisualElement name="managed-list" class="imv2-inspector-list" />

            <ui:VisualElement name="managed-empty" class="dennoko-empty-state imv2-empty-compact">
                <ui:Label name="managed-empty-message" text="管理対象の Inspector がありません" class="dennoko-empty-state__message" />
                <ui:Button name="managed-empty-add" text="+ 追加" class="dennoko-button-secondary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 外部 Inspector カード (検出時のみ表示) -->
        <ui:VisualElement name="external-card" class="dennoko-card imv2-section-card">
            <ui:VisualElement class="dennoko-card-header dennoko-card-header--row">
                <ui:Label name="external-card-title" text="外部 Inspector (0)" class="dennoko-section-title dennoko-card-header__title" />
            </ui:VisualElement>
            <ui:VisualElement name="external-list" class="imv2-inspector-list" />
        </ui:VisualElement>

    </ui:ScrollView>

    <!-- 標準フッター (カードで囲まない) -->
    <ui:VisualElement class="dennoko-footer imv2-footer">
        <ui:Label name="footer-info" text="" class="dennoko-footer__info" />
        <ui:Button name="add-inspector-button" text="+ 追加" class="dennoko-button-secondary" />
        <ui:Button name="primary-toggle-button" text="開始" class="dennoko-button-primary" />
    </ui:VisualElement>

    <!-- 標準ステータスバー -->
    <ui:Label name="status-label" text="停止中 (Off)" class="dennoko-status" />
</ui:UXML>
