/* Inspector Manager V2 — dennokoworks-design 独自レイアウト補助スタイル
 * 規則: すべてのルールに .dennoko-root を前置、カラーコード直書き禁止 (var(--dennoko-*) のみ)
 */

.dennoko-root .imv2-banner-fixed {
    flex-shrink: 0;
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 6px;
}

.dennoko-root .imv2-helpbox-fixed {
    flex-shrink: 0;
    margin-left: 8px;
    margin-right: 8px;
    margin-top: 6px;
}

.dennoko-root .imv2-section-card {
    margin-bottom: 8px;
}

.dennoko-root .imv2-card-hint {
    margin-top: 6px;
}

.dennoko-root .imv2-inspector-list {
    flex-direction: column;
}

.dennoko-root .imv2-row {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    padding-left: 6px;
    padding-right: 4px;
    padding-top: 3px;
    padding-bottom: 3px;
    margin-bottom: 4px;
    border-radius: 4px;
    background-color: var(--dennoko-surface-0);
    border-width: 1px;
    border-color: var(--dennoko-outline-subtle);
}

.dennoko-root .imv2-row:hover {
    background-color: var(--dennoko-hover-overlay);
    border-color: var(--dennoko-outline);
}

.dennoko-root .imv2-row--participating {
    border-left-width: 3px;
    border-left-color: var(--dennoko-selection-border);
}

.dennoko-root .imv2-row--excluded {
    border-left-width: 3px;
    border-left-color: var(--dennoko-semantic-warning);
}

.dennoko-root .imv2-row--unlocked {
    border-left-width: 3px;
    border-left-color: var(--dennoko-text-tertiary);
}

.dennoko-root .imv2-row--fault {
    border-left-width: 3px;
    border-left-color: var(--dennoko-semantic-error-text);
}

.dennoko-root .imv2-row__num {
    width: 28px;
    flex-shrink: 0;
    -unity-font-style: bold;
    color: var(--dennoko-text-primary);
    font-size: 11px;
}

.dennoko-root .imv2-row__role {
    min-width: 44px;
    flex-shrink: 0;
    margin-right: 4px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-radius: 3px;
    font-size: 10px;
    -unity-text-align: middle-center;
    background-color: var(--dennoko-surface-2);
    color: var(--dennoko-text-secondary);
}

.dennoko-root .imv2-row__role--latest {
    background-color: var(--dennoko-selection-bg);
    border-width: 1px;
    border-color: var(--dennoko-selection-border);
    color: var(--dennoko-text-primary);
}

.dennoko-root .imv2-row__main {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    flex-direction: column;
    margin-right: 4px;
}

.dennoko-root .imv2-row__target {
    color: var(--dennoko-text-primary);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dennoko-root .imv2-row__sub {
    color: var(--dennoko-text-tertiary);
    font-size: 10px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.dennoko-root .imv2-row__sub--warning {
    color: var(--dennoko-semantic-warning);
}

.dennoko-root .imv2-row__sub--error {
    color: var(--dennoko-semantic-error-text);
}

.dennoko-root .imv2-row__actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.dennoko-root .imv2-row-btn {
    height: 20px;
    min-width: 22px;
    padding-left: 5px;
    padding-right: 5px;
    margin-left: 2px;
    margin-right: 0;
    font-size: 10px;
    flex-shrink: 0;
}

.dennoko-root .imv2-row-btn--lock-on {
    border-color: var(--dennoko-selection-border);
    background-color: var(--dennoko-selection-bg);
    color: var(--dennoko-text-primary);
}

.dennoko-root .imv2-row-btn--excluded {
    border-color: var(--dennoko-semantic-warning);
    color: var(--dennoko-semantic-warning);
}

.dennoko-root .imv2-sub-separator {
    margin-top: 8px;
    margin-bottom: 8px;
}

.dennoko-root .imv2-sub-title {
    margin-bottom: 2px;
}

.dennoko-root .imv2-category-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.dennoko-root .imv2-category-toggle {
    width: 120px;
    margin-right: 6px;
    margin-bottom: 2px;
}
